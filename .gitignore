# Rust build output
/target/
/plugins/target/
**/target/
# worker-build writes here, and the rule above does not reach it
/relay/build/
node_modules/
# wrangler caches the account it deployed as, name and all
.wrangler/

# rustfmt backups
**/*.rs.bk

# MSVC debug info
*.pdb

# Cargo
# The workspace lock is unpublished for now, with the rest of the block below.
# relay/Cargo.lock is tracked: a Worker build has to be reproducible.

# Profiling / coverage
*.profraw
*.profdata
perf.data*
flamegraph.svg

# Editors / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Project-local state (config, plugins, sessions)
.ah/

# Not published yet. plugins/themes is the published reference plugin.
/README.md
/justfile
/Cargo.lock
/scripts/
/plugins/*
!/plugins/themes/
/plugins/themes/Cargo.lock
!/plugins/.cargo/
